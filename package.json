{
  "name": "tiecamel",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm governance:sdk && pnpm --recursive --filter './apps/*' build",
    "check": "pnpm governance:sdk && pnpm --recursive --if-present --filter './apps/*' check",
    "convex:dev": "pnpm --filter @tiecamel/app convex:dev",
    "convex:deploy": "pnpm --filter @tiecamel/app convex:deploy",
    "deploy:app": "pnpm governance:sdk && pnpm --filter @tiecamel/app run deploy",
    "build:demo": "pnpm governance:sdk && node scripts/build-app-demo.mjs",
    "build:operational-test": "pnpm governance:sdk && node --env-file=apps/app/.env.development.local scripts/build-app-operational-test.mjs",
    "deploy:demo": "pnpm build:demo && pnpm --filter @tiecamel/app exec wrangler deploy --keep-vars",
    "deploy:web": "pnpm --filter @tiecamel/web run deploy",
    "dev": "pnpm governance:sdk && pnpm --parallel --filter @tiecamel/app --filter @tiecamel/web dev",
    "dev:app": "pnpm governance:sdk && pnpm --filter @tiecamel/app dev",
    "dev:web": "pnpm --filter @tiecamel/web dev",
    "format": "pnpm --filter @tiecamel/app format",
    "lint": "pnpm --filter @tiecamel/app lint",
    "test": "pnpm governance:sdk && pnpm --recursive --if-present --filter './apps/*' test",
    "governance:sdk": "pnpm --filter @tiecamel/governance build",
    "governance:build": "anchor build --no-idl -- --tools-version v1.56 && anchor idl build --out packages/governance-idl/tiecamel_governance.json --out-ts packages/governance-idl/tiecamel_governance.ts",
    "governance:test": "pnpm governance:sdk && node scripts/test-governance-localnet.mjs",
    "governance:verify": "node scripts/verify-governance-proof.mjs"
  }
}
