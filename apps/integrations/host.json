{
	"version": "2.0",
	"extensionBundle": {
		"id": "Microsoft.Azure.Functions.ExtensionBundle",
		"version": "[4.0.0, 5.0.0)"
	},
	"extensions": {
    "serviceBus": {
      "prefetchCount": 8,
      "messageHandlerOptions": {
        "autoCompleteMessages": false,
        "maxConcurrentCalls": 4,
        "maxAutoRenewDuration": "00:10:00"
      }
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  }
}
