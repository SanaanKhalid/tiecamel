# Copy this file to .env.<client>.local, then run:
# pnpm dev:app -- --mode <client>

# Client profile (safe to expose to the browser)
VITE_TIECAMEL_CLIENT_ID=demo-nonprofit
VITE_TIECAMEL_CLIENT_NAME="TieCamel Demo Foundation"
VITE_TIECAMEL_CLIENT_SHORT_NAME="Demo Foundation"
VITE_TIECAMEL_SUPPORT_EMAIL=support@tiecamel.com
VITE_TIECAMEL_LANDING_URL=http://localhost:4321
VITE_TIECAMEL_ACCENT=#092d2a
VITE_TIECAMEL_DEMO_MODE=true

# Clerk: use a separate Clerk application or environment for each client.
# Keep CLERK_SECRET_KEY server-only. Never add the VITE_ prefix to it.
VITE_CLERK_PUBLISHABLE_KEY=
# Prevents duplicate warning amplification in local TanStack dev logs only.
VITE_CLERK_UNSAFE_DISABLE_DEVELOPMENT_MODE_CONSOLE_WARNING=true
CLERK_SECRET_KEY=

# Convex: use a separate deployment for each client/environment during the pilot.
VITE_CONVEX_URL=

# Convex server environment variables (set with `npx convex env set`)
# AZURE_INTEGRATION_URL=https://<function-app>.azurewebsites.net/api
# AZURE_INTEGRATION_TOKEN=<Key Vault-backed command token>
# AZURE_CALLBACK_SECRET=<shared HMAC secret>
# Set this in the Convex deployment environment, not in the browser bundle.
CLERK_FRONTEND_API_URL=
